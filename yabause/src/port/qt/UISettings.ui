<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>UISettings</class>
 <widget class="QDialog" name="UISettings">
  <property name="geometry"><rect><x>0</x><y>0</y><width>1100</width><height>700</height></rect></property>
  <property name="minimumSize"><size><width>860</width><height>520</height></size></property>
  <property name="windowTitle"><string>Settings</string></property>
  <property name="styleSheet"><string notr="true">
QDialog#UISettings { background:#f3f6fb; }
QWidget { color:#1f2937; font-size:12px; }
QWidget[role="pagecontent"], QScrollArea { background:transparent; border:none; }
QScrollArea &gt; QWidget &gt; QWidget { background:transparent; }
QTabWidget::pane { border:0; background:transparent; }
QFrame#fSidebar { background:#ffffff; border-right:1px solid #e1e7f0; }
QLabel#lSidebarTitle { color:#2f7df6; font-size:18px; font-weight:bold; padding:20px 20px 12px 20px; }
QListWidget#lwPages { background:transparent; border:0; outline:0; }
QListWidget#lwPages::item { padding:10px 12px; margin:2px 10px; border-radius:9px; color:#4b5563; border-left:3px solid transparent; }
QListWidget#lwPages::item:hover { background:#eef3fb; color:#111827; }
QListWidget#lwPages::item:selected { background:#e3edff; color:#2f7df6; font-weight:bold; border-left:3px solid #2f7df6; }
QGroupBox[role="card"] { background:#ffffff; border:1px solid #e1e7f0; border-radius:12px; margin-top:20px; padding:16px 14px 10px 14px; }
QGroupBox[role="card"]::title { subcontrol-origin:margin; subcontrol-position:top left; left:10px; top:-2px; padding:0 6px; color:#2f7df6; font-size:12px; font-weight:bold; }
QGroupBox[role="card"] QFrame[frameShape="6"] { background:#f7f9fc; border:1px solid #e1e7f0; border-radius:8px; }
QGroupBox[role="card"] QFrame[frameShape="6"] QToolButton { background:#6b7a94; border:1px solid #5b6a84; padding:4px 8px; }
QGroupBox[role="card"] QFrame[frameShape="6"] QToolButton:hover { background:#2f7df6; border-color:#2f7df6; }
QGroupBox[role="card"] QFrame[frameShape="6"] QToolButton:pressed { background:#1f5fd0; }
QLabel { background:transparent; color:#374151; }
QLabel[role="hint"] { color:#6b7686; font-size:11px; }
QLabel[role="value"] { color:#2f7df6; font-weight:bold; }
QLineEdit, QDateTimeEdit, QComboBox { background:#f7f9fc; border:1px solid #d3dbe8; border-radius:7px; padding:5px 9px; min-height:18px; selection-background-color:#2f7df6; selection-color:#ffffff; color:#111827; }
QLineEdit:hover, QDateTimeEdit:hover, QComboBox:hover { border-color:#9db4dc; }
QLineEdit:focus, QDateTimeEdit:focus, QComboBox:focus { border-color:#2f7df6; background:#ffffff; }
QLineEdit:disabled, QDateTimeEdit:disabled, QComboBox:disabled { color:#a3acb9; background:#eef1f6; border-color:#e1e7f0; }
QComboBox { padding-right:28px; }
QComboBox::drop-down { border:0; width:28px; subcontrol-origin:padding; subcontrol-position:center right; }
QComboBox::down-arrow { image:url(:/settings/arrow.png); width:12px; height:12px; margin-right:10px; }
QComboBox QAbstractItemView { background:#ffffff; border:1px solid #d3dbe8; selection-background-color:#e3edff; selection-color:#2f7df6; outline:0; padding:4px; color:#111827; }
QDateTimeEdit::drop-down { border:0; width:28px; subcontrol-origin:padding; subcontrol-position:center right; }
QDateTimeEdit::down-arrow { image:url(:/settings/arrow.png); width:12px; height:12px; margin-right:10px; }
QCalendarWidget QWidget { background:#ffffff; color:#1f2937; }
QCalendarWidget QAbstractItemView { selection-background-color:#2f7df6; selection-color:#ffffff; }
QCheckBox { spacing:8px; color:#1f2937; padding:3px 0; }
QCheckBox::indicator { width:18px; height:18px; border:2px solid #b8c3d6; border-radius:6px; background:#ffffff; }
QCheckBox::indicator:hover { border-color:#2f7df6; }
QCheckBox::indicator:checked { background:#2f7df6; border-color:#2f7df6; image:url(:/settings/check.png); }
QCheckBox::indicator:disabled { border-color:#dbe1ec; background:#eef1f6; }
QCheckBox:disabled { color:#a3acb9; }
QSlider::groove:horizontal { height:6px; background:#dbe3f0; border-radius:3px; }
QSlider::sub-page:horizontal { background:#2f7df6; border-radius:3px; }
QSlider::handle:horizontal { background:#ffffff; border:2px solid #2f7df6; width:14px; height:14px; margin:-7px 0; border-radius:9px; }
QToolButton { background:#eef3fb; border:1px solid #d3dbe8; border-radius:7px; padding:5px 10px; min-height:18px; color:#1f2937; }
QToolButton:hover { background:#e3edff; border-color:#2f7df6; }
QToolButton:pressed { background:#d3e2fb; }
QToolButton:disabled { color:#a3acb9; background:#f1f4f9; border-color:#e1e7f0; }
QToolButton:checked { background:#e3edff; border-color:#2f7df6; }
QFrame#fFooter { background:#ffffff; border-top:1px solid #e1e7f0; }
QDialogButtonBox QPushButton { background:#eef3fb; color:#1f2937; border:1px solid #d3dbe8; border-radius:8px; padding:8px 22px; min-width:84px; }
QDialogButtonBox QPushButton:hover { background:#e3edff; border-color:#9db4dc; }
QDialogButtonBox QPushButton:pressed { background:#d3e2fb; }
QDialogButtonBox QPushButton:default { background:#2f7df6; color:#ffffff; border-color:#2f7df6; font-weight:bold; }
QDialogButtonBox QPushButton:default:hover { background:#5495f8; }
QTableWidget { background:#ffffff; alternate-background-color:#f7f9fc; border:1px solid #e1e7f0; border-radius:10px; gridline-color:#eef1f6; selection-background-color:#e3edff; selection-color:#111827; outline:0; }
QTableWidget::item { padding:4px 8px; }
QHeaderView::section { background:#f3f6fb; color:#4b5563; border:0; border-bottom:1px solid #e1e7f0; padding:8px; font-weight:bold; }
QTableCornerButton::section { background:#f3f6fb; border:0; }
QScrollBar:vertical { background:transparent; width:12px; margin:2px; }
QScrollBar::handle:vertical { background:#c9d3e3; border-radius:4px; min-height:30px; }
QScrollBar::handle:vertical:hover { background:#9db4dc; }
QScrollBar:horizontal { background:transparent; height:12px; margin:2px; }
QScrollBar::handle:horizontal { background:#c9d3e3; border-radius:4px; min-width:30px; }
QScrollBar::add-line, QScrollBar::sub-line { width:0; height:0; }
QScrollBar::add-page, QScrollBar::sub-page { background:transparent; }
QToolTip { background:#ffffff; color:#1f2937; border:1px solid #c9d3e3; padding:4px; }
