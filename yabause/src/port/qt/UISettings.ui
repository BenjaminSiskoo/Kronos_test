       </item><item row="0" column="1" rowspan="1" colspan="1"><widget class="QLineEdit" name="leAddr2Line" />
         </item><item row="0" column="2" rowspan="1" colspan="1"><widget class="QToolButton" name="tbAddr2Line">
           <property name="text">
            <string>...</string>
           </property>
          </widget>
         </item><item row="1" column="0" rowspan="1" colspan="1"><widget class="QLabel" name="laddr2lineElf">
         <property name="text">
          <string>ELF file</string>
         </property>
         <property name="toolTip">
          <string>ELF file used by the SH-2 debugger to show function names and source lines (addr2line). Leave empty to look for &lt;image name&gt;.elf next to the loaded image, then in its build subfolder.</string>
         </property>
         <property name="textFormat">
          <enum>Qt::PlainText</enum>
         </property>
        <property name="alignment"><set>Qt::AlignLeading|Qt::AlignLeft|Qt::AlignVCenter</set></property><property name="role" stdset="0"><string notr="true">row</string></property><property name="minimumSize"><size><width>150</width><height>0</height></size></property></widget>
       </item><item row="1" column="1" rowspan="1" colspan="1"><widget class="QLineEdit" name="leElfFile"><property name="toolTip"><string>ELF file used by the SH-2 debugger to show function names and source lines (addr2line). Leave empty to look for &lt;image name&gt;.elf next to the loaded image, then in its build subfolder.</string></property><property name="placeholderText"><string>Automatic: &lt;image name&gt;.elf next to the image</string></property></widget>
         </item><item row="1" column="2" rowspan="1" colspan="1"><widget class="QToolButton" name="tbElfFile">
           <property name="text">
            <string>...</string>
           </property>
          </widget>
         </item><item row="2" column="0" rowspan="1" colspan="3"><widget class="QLabel" name="lDebugHelp"><property name="text"><string>The SH-2 debugger shows function names and source lines by running addr2line (sh-elf-addr2line from the Saturn toolchain) on the ELF file of the game. Choose the ELF file here, or leave it empty to use &lt;image name&gt;.elf next to the loaded image (or in its build subfolder).</string></property><property name="wordWrap"><bool>true</bool></property></widget></item></layout></widget></item><item><widget class="QGroupBox" name="cardDebugTools"><property name="title"><string>SH-2 GDB stub and tracer</string></property><property name="role" stdset="0"><string notr="true">card</string></property><layout class="QGridLayout" name="glDebugTools" columnstretch="0,1,0"><property name="leftMargin"><number>0</number></property><property name="topMargin"><number>0</number></property><property name="rightMargin"><number>0</number></property><property name="bottomMargin"><number>0</number></property><property name="horizontalSpacing"><number>10</number></property><property name="verticalSpacing"><number>10</number></property><item row="0" column="0" colspan="3"><widget class="QCheckBox" name="cbGdbStub"><property name="text"><string>Enable the GDB stub for both SH-2</string></property><property name="toolTip"><string>Listens on a TCP port; the emulation halts when GDB connects (set architecture sh2, set endian big, target remote 127.0.0.1:PORT). Forces the slower SH-2 debug interpreter.</string></property></widget></item><item row="1" column="0"><widget class="QLabel" name="lGdbPort"><property name="text"><string>TCP port</string></property><property name="textFormat"><enum>Qt::PlainText</enum></property><property name="alignment"><set>Qt::AlignLeading|Qt::AlignLeft|Qt::AlignVCenter</set></property><property name="role" stdset="0"><string notr="true">row</string></property></widget></item><item row="1" column="1"><widget class="QSpinBox" name="sbGdbPort"><property name="minimum"><number>1024</number></property><property name="maximum"><number>65535</number></property><property name="value"><number>43434</number></property></widget></item><item row="2" column="0" colspan="3"><widget class="QCheckBox" name="cbGdbRemote"><property name="text"><string>Accept connections from other machines</string></property><property name="toolTip"><string>Default: local connections only (127.0.0.1). GDB gives full access to the memory: use it on a trusted network only.</string></property></widget></item><item row="3" column="0" colspan="3"><widget class="QCheckBox" name="cbSH2Trace"><property name="text"><string>Write an SH-2 / bus trace</string></property><property name="toolTip"><string>Writes every instruction executed by both SH-2 to a text file. Forces the slower SH-2 debug interpreter. Compare two traces with tools/tracediff.py.</string></property></widget></item><item row="4" column="0"><widget class="QLabel" name="lTraceFile"><property name="text"><string>Trace file</string></property><property name="textFormat"><enum>Qt::PlainText</enum></property><property name="alignment"><set>Qt::AlignLeading|Qt::AlignLeft|Qt::AlignVCenter</set></property><property name="role" stdset="0"><string notr="true">row</string></property></widget></item><item row="4" column="1"><widget class="QLineEdit" name="leTraceFile"><property name="placeholderText"><string>kronos_trace.txt</string></property></widget></item><item row="4" column="2"><widget class="QToolButton" name="tbTraceFile"><property name="text"><string>...</string></property></widget></item><item row="5" column="0"><widget class="QLabel" name="lTraceOpts"><property name="text"><string>Trace options</string></property><property name="toolTip"><string>Comma separated, addresses in hexadecimal: bus, regs, cycles=0, cpu=m|s|ms, pc=LO-HI, addr=LO-HI, start=PC, stop=PC, skip=N, max=N</string></property><property name="textFormat"><enum>Qt::PlainText</enum></property><property name="alignment"><set>Qt::AlignLeading|Qt::AlignLeft|Qt::AlignVCenter</set></property><property name="role" stdset="0"><string notr="true">row</string></property></widget></item><item row="5" column="1" colspan="2"><widget class="QLineEdit" name="leTraceOpts"><property name="placeholderText"><string>bus,regs,max=1000000</string></property></widget></item><item row="6" column="0" colspan="3"><widget class="QLabel" name="lDebugToolsHelp"><property name="text"><string>Applied the next time the emulation starts. Options given on the command line (--gdb, --trace) take precedence over these settings. See the Debugging sections of the readme.</string></property><property name="wordWrap"><bool>true</bool></property></widget></item></layout></widget></item><item><widget class="QGroupBox" name="cardRewind"><property name="title"><string>Rewind</string></property><property name="role" stdset="0"><string notr="true">card</string></property><layout class="QGridLayout" name="glRewind" columnstretch="0,1,0"><property name="leftMargin"><number>0</number></property><property name="topMargin"><number>0</number></property><property name="rightMargin"><number>0</number></property><property name="bottomMargin"><number>0</number></property><property name="horizontalSpacing"><number>10</number></property><property name="verticalSpacing"><number>10</number></property><item row="0" column="0" colspan="3"><widget class="QCheckBox" name="cbRewind"><property name="text"><string>Enable rewind</string></property><property name="toolTip"><string>Keeps the last seconds of emulation in memory. Go back with Tools &gt; Rewind (Backspace, hold to keep going back). Costs some CPU time; off by default.</string></property></widget></item><item row="1" column="0"><widget class="QLabel" name="lRewindInterval"><property name="text"><string>Capture every</string></property><property name="toolTip"><string>Number of frames between two captures. A step back goes back this many frames: 1 is the most precise, larger values use less CPU.</string></property><property name="textFormat"><enum>Qt::PlainText</enum></property><property name="alignment"><set>Qt::AlignLeading|Qt::AlignLeft|Qt::AlignVCenter</set></property><property name="role" stdset="0"><string notr="true">row</string></property></widget></item><item row="1" column="1"><widget class="QSpinBox" name="sbRewindInterval"><property name="minimum"><number>1</number></property><property name="maximum"><number>60</number></property><property name="value"><number>3</number></property><property name="suffix"><string> frames</string></property></widget></item><item row="2" column="0"><widget class="QLabel" name="lRewindSeconds"><property name="text"><string>Buffer length</string></property><property name="toolTip"><string>How far back you can go</string></property><property name="textFormat"><enum>Qt::PlainText</enum></property><property name="alignment"><set>Qt::AlignLeading|Qt::AlignLeft|Qt::AlignVCenter</set></property><property name="role" stdset="0"><string notr="true">row</string></property></widget></item><item row="2" column="1"><widget class="QSpinBox" name="sbRewindSeconds"><property name="minimum"><number>1</number></property><property name="maximum"><number>600</number></property><property name="value"><number>30</number></property><property name="suffix"><string> s</string></property></widget></item><item row="3" column="0"><widget class="QLabel" name="lRewindMemory"><property name="text"><string>Memory limit</string></property><property name="toolTip"><string>The buffer never uses more than this, the oldest captures are dropped first</string></property><property name="textFormat"><enum>Qt::PlainText</enum></property><property name="alignment"><set>Qt::AlignLeading|Qt::AlignLeft|Qt::AlignVCenter</set></property><property name="role" stdset="0"><string notr="true">row</string></property></widget></item><item row="3" column="1"><widget class="QSpinBox" name="sbRewindMemory"><property name="minimum"><number>16</number></property><property name="maximum"><number>4096</number></property><property name="value"><number>512</number></property><property name="suffix"><string> MB</string></property></widget></item><item row="4" column="0" colspan="3"><widget class="QLabel" name="lRewindHelp"><property name="text"><string>Shortcut: Backspace (Tools &gt; Rewind). Not available while an input movie is loaded. The backup memory is not rewound. The buffer is emptied when the game restarts.</string></property><property name="wordWrap"><bool>true</bool></property></widget></item></layout></widget></item><item><spacer name="pgDebug_sp"><property name="orientation"><enum>Qt::Vertical</enum></property><property name="sizeHint" stdset="0"><size><width>20</width><height>20</height></size></property></spacer></item></layout></widget></widget></item></layout></widget></widget></item></layout></item><item><widget class="QFrame" name="fFooter"><layout class="QHBoxLayout" name="footerLayout"><property name="leftMargin"><number>20</number></property><property name="topMargin"><number>12</number></property><property name="rightMargin"><number>20</number></property><property name="bottomMargin"><number>12</number></property><item><spacer name="footerSpacer"><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property></spacer></item><item><widget class="QDialogButtonBox" name="dbbButtons"><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="standardButtons"><set>QDialogButtonBox::Cancel|QDialogButtonBox::Ok</set></property></widget></item></layout></widget></item></layout>
 </widget>
