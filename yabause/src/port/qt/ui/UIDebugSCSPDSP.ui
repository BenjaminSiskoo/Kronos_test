<?xml version="1.0" encoding="UTF-8"?>
<!--
  BUG: ce fichier etait une copie non adaptee de UIDebugSCSP.ui (widgets
  slot audio/"Play Slot"/"Save as WAV" qui n'ont aucun sens pour un debug
  DSP), avec en plus une balise <class> qui ne correspondait meme pas au
  nom du fichier ("UIDebugSCSP" au lieu de "UIDebugSCSPDSP"). uic generait
  donc un ui_UIDebugSCSPDSP.h totalement inutilise (UIDebugSCSPDSP.cpp ne
  l'inclut pas ; il construit son UI par composition via UIDebugCPU + des
  QTabWidget crees dans le code) et un warning de connexion invalide au
  build ("dbbButtons" -> "UIDebugSCSP"). Remplace par un stub minimal et
  correctement nomme, gardé uniquement pour ne pas casser le CMakeLists.txt
  qui liste ce fichier.
-->
<ui version="4.0">
 <class>UIDebugSCSPDSP</class>
 <widget class="QWidget" name="UIDebugSCSPDSP">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>1</width>
    <height>1</height>
   </rect>
  </property>
 </widget>
 <resources/>
 <connections/>
</ui>
