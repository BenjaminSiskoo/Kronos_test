  <property name="styleSheet"><string notr="true">QDialog#UIMahjongSetting { background:#0b1f16; }
QFrame[role="panel"] { background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #16402b,stop:1 #0f3020); border:1px solid #2a6a47; border-radius:12px; }
QFrame[role="gate"] { background:#0a1a12; border:2px solid #2a6a47; border-radius:78px; }
QFrame[role="ball"] { background:qradialgradient(cx:0.35,cy:0.3,radius:0.95,fx:0.35,fy:0.3,stop:0 #ffffff,stop:1 #999999); border:1px solid #000000; border-radius:38px; }
QToolButton { font-weight:bold; font-size:11px; padding:0px; }
QToolButton:focus { outline:none; }
QToolButton[role="tile"] { color:#1d2b22; font-size:16px; border-radius:8px; border:2px solid rgba(0,0,0,150); background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #fbf8ea,stop:1 #d8d1b4); }
QToolButton[role="tile"]:hover { border:2px solid rgba(255,255,255,200); background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #ffffff,stop:1 #ebe4c8); }
QToolButton[role="tile"]:checked { border:3px solid #ffd23f; }
QToolButton[role="tile"]:disabled { color:#6b6f78; border:2px solid #2a2d33; background:#23262c; }
QToolButton[role="call"] { color:#ffffff; font-size:12px; border-radius:8px; border:2px solid rgba(0,0,0,150); background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #6fc08a,stop:1 #2f7a4c); }
QToolButton[role="call"]:hover { border:2px solid rgba(255,255,255,200); background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #8bd8a4,stop:1 #3a9560); }
QToolButton[role="call"]:checked { border:3px solid #ffd23f; }
QToolButton[role="call"]:disabled { color:#6b6f78; border:2px solid #2a2d33; background:#23262c; }
QToolButton[role="reach"] { color:#ffffff; font-size:12px; border-radius:8px; border:2px solid rgba(0,0,0,150); background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #f07a6c,stop:1 #b02a1e); }
QToolButton[role="reach"]:hover { border:2px solid rgba(255,255,255,200); background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #ff9a8d,stop:1 #cc3a2c); }
QToolButton[role="reach"]:checked { border:3px solid #ffd23f; }
QToolButton[role="reach"]:disabled { color:#6b6f78; border:2px solid #2a2d33; background:#23262c; }
QToolButton[role="ron"] { color:#ffffff; font-size:12px; border-radius:8px; border:2px solid rgba(0,0,0,150); background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #e8505a,stop:1 #8e1822); }
QToolButton[role="ron"]:hover { border:2px solid rgba(255,255,255,200); background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #ff7580,stop:1 #aa2230); }
QToolButton[role="ron"]:checked { border:3px solid #ffd23f; }
QToolButton[role="ron"]:disabled { color:#6b6f78; border:2px solid #2a2d33; background:#23262c; }
QToolButton[role="start"] { color:#ffffff; font-size:12px; border-radius:8px; border:2px solid rgba(0,0,0,150); background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #4cc16b,stop:1 #1f6b36); }
QToolButton[role="start"]:hover { border:2px solid rgba(255,255,255,200); background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #6ddc8b,stop:1 #2a8a47); }
QToolButton[role="start"]:checked { border:3px solid #ffd23f; }
QToolButton[role="start"]:disabled { color:#6b6f78; border:2px solid #2a2d33; background:#23262c; }
QToolButton[role="bet"] { color:#2b1a02; font-size:12px; border-radius:8px; border:2px solid rgba(0,0,0,150); background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #f5cf63,stop:1 #a77514); }
QToolButton[role="bet"]:hover { border:2px solid rgba(255,255,255,200); background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #ffe08a,stop:1 #c8901e); }
QToolButton[role="bet"]:checked { border:3px solid #ffd23f; }
QToolButton[role="bet"]:disabled { color:#6b6f78; border:2px solid #2a2d33; background:#23262c; }
QToolButton[role="flip"] { color:#ffffff; font-size:11px; border-radius:8px; border:2px solid rgba(0,0,0,150); background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #9aa6b8,stop:1 #4a5568); }
QToolButton[role="flip"]:hover { border:2px solid rgba(255,255,255,200); background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #b9c4d4,stop:1 #5f6c82); }
QToolButton[role="flip"]:checked { border:3px solid #ffd23f; }
QToolButton[role="flip"]:disabled { color:#6b6f78; border:2px solid #2a2d33; background:#23262c; }
QLabel[role="title"] { color:#9fd8b4; font-weight:bold; font-size:12px; letter-spacing:2px; }
QLabel[role="note"] { color:#86ad96; font-size:10px; }
QLabel#lTitle, QLabel[role="hint"] { color:#86ad96; font-size:11px; }
QLabel#lInfos { color:#ffd23f; font-weight:bold; font-size:13px; }
QLabel[role="spinlabel"] { color:#9fd8b4; font-size:11px; }
QSpinBox { background:#0f3020; color:#e6f4ea; border:1px solid #2a6a47; border-radius:5px; padding:2px 6px; }
QToolTip { background:#1f2530; color:#e6ecf7; border:1px solid #3a4352; padding:3px; }
QDialogButtonBox QPushButton { background:#1d4a33; color:#e6f4ea; border:1px solid #2a6a47; border-radius:6px; padding:6px 18px; min-width:70px; }
QDialogButtonBox QPushButton:hover { background:#27603f; }
QDialogButtonBox QPushButton:pressed { background:#16402b; }</string></property>
  <widget class="QLabel" name="lTitle">
   <property name="geometry"><rect><x>24</x><y>12</y><width>692</width><height>44</height></rect></property>
   <property name="text"><string>Sega Mahjong Panel (kiwames, vmahjong, myfairld). A-N select tiles; Kan/Pon/Chi/Reach/Ron are the action buttons. Player 2's panel only exists on the 2-player cabinet (Pro Mahjong Kiwame S).</string></property>
