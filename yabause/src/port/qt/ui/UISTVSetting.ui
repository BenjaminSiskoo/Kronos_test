  <property name="windowTitle"><string>ST-V cabinet Configuration</string></property>
  <property name="styleSheet"><string notr="true">
QDialog#UISTVSetting { background:#0f1217; }
QToolButton { color:#ffffff; font-weight:bold; font-size:11px; border:2px solid rgba(0,0,0,150); padding:0px; }
QToolButton:focus { outline:none; }
QToolButton#tbA,QToolButton#tbB,QToolButton#tbC,QToolButton#tbA_P2,QToolButton#tbB_P2,QToolButton#tbC_P2 { border-radius:27px; background:qradialgradient(cx:0.35,cy:0.3,radius:0.95,fx:0.35,fy:0.3,stop:0 #ff8f84,stop:1 #b3261e); }
QToolButton#tbA,QToolButton#tbB,QToolButton#tbC,QToolButton#tbA_P2,QToolButton#tbB_P2,QToolButton#tbC_P2:hover { background:qradialgradient(cx:0.35,cy:0.3,radius:0.95,fx:0.35,fy:0.3,stop:0 #ffb3aa,stop:1 #d2362c); }
QToolButton#tbX,QToolButton#tbY,QToolButton#tbZ,QToolButton#tbX_P2,QToolButton#tbY_P2,QToolButton#tbZ_P2 { border-radius:27px; background:qradialgradient(cx:0.35,cy:0.3,radius:0.95,fx:0.35,fy:0.3,stop:0 #8fb8ff,stop:1 #1f55b8); }
QToolButton#tbX,QToolButton#tbY,QToolButton#tbZ,QToolButton#tbX_P2,QToolButton#tbY_P2,QToolButton#tbZ_P2:hover { background:qradialgradient(cx:0.35,cy:0.3,radius:0.95,fx:0.35,fy:0.3,stop:0 #b5d0ff,stop:1 #2f6fd6); }
QToolButton#tbUp,QToolButton#tbRight,QToolButton#tbDown,QToolButton#tbLeft,QToolButton#tbUP_P2,QToolButton#tbRIGHT_P2,QToolButton#tbDOWN_P2,QToolButton#tbLEFT_P2 { border-radius:18px; font-size:12px; background:qradialgradient(cx:0.35,cy:0.3,radius:0.95,fx:0.35,fy:0.3,stop:0 #6b7686,stop:1 #2a313c); }
QToolButton#tbUp:hover,QToolButton#tbRight:hover,QToolButton#tbDown:hover,QToolButton#tbLeft:hover,QToolButton#tbUP_P2:hover,QToolButton#tbRIGHT_P2:hover,QToolButton#tbDOWN_P2:hover,QToolButton#tbLEFT_P2:hover { background:qradialgradient(cx:0.35,cy:0.3,radius:0.95,fx:0.35,fy:0.3,stop:0 #8b97a9,stop:1 #3a4352); }
QToolButton#tbStart1,QToolButton#tbStart2 { border-radius:9px; font-size:10px; background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #4cc16b,stop:1 #25773c); }
QToolButton#tbCoin1,QToolButton#tbCoin2 { border-radius:9px; font-size:10px; background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #f0b844,stop:1 #a8731a); }
QToolButton#tbService,QToolButton#tbTest { border-radius:9px; font-size:10px; background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #7d8aa0,stop:1 #475264); }
QToolButton#tbMultiCart,QToolButton#tbPause { border-radius:9px; font-size:10px; background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #9a85e0,stop:1 #5b45a8); }
QToolButton#tbStart1:hover,QToolButton#tbStart2:hover,QToolButton#tbCoin1:hover,QToolButton#tbCoin2:hover,QToolButton#tbService:hover,QToolButton#tbTest:hover,QToolButton#tbMultiCart:hover,QToolButton#tbPause:hover { border:2px solid rgba(255,255,255,170); }
QToolButton:checked { border:3px solid #35e0ff; }
QLabel#lCaption1, QLabel#lCaption2 { color:#9aa6b8; font-weight:bold; font-size:12px; letter-spacing:2px; }
QLabel#lHint { color:#7f8a9c; font-size:11px; }
QLabel#lInfos { color:#35e0ff; font-weight:bold; font-size:13px; }
QToolTip { background:#1f2530; color:#e6ecf7; border:1px solid #3a4352; padding:3px; }
QDialogButtonBox QPushButton { background:#2a303b; color:#dfe6f2; border:1px solid #3a4352; border-radius:6px; padding:6px 18px; min-width:70px; }
QDialogButtonBox QPushButton:hover { background:#364050; }
QDialogButtonBox QPushButton:pressed { background:#1f2530; }
</string></property>
