  <property name="styleSheet"><string notr="true">QDialog#UIPatocarSetting { background:#1c0f12; }
QFrame[role="panel"] { background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #34191e,stop:1 #26121a); border:1px solid #5a2b34; border-radius:12px; }
QFrame[role="gate"] { background:#1a0c10; border:2px solid #5a2b34; border-radius:78px; }
QFrame[role="ball"] { background:qradialgradient(cx:0.35,cy:0.3,radius:0.95,fx:0.35,fy:0.3,stop:0 #ff9a90,stop:1 #6a1410); border:1px solid #000000; border-radius:38px; }
QToolButton { font-weight:bold; font-size:11px; padding:0px; }
QToolButton:focus { outline:none; }
QToolButton[role="coin"] { color:#2b1a02; font-size:11px; border-radius:9px; border:2px solid rgba(0,0,0,170); background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #f5cf63,stop:1 #a77514); }
QToolButton[role="coin"]:hover { border:2px solid rgba(255,255,255,170); background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #ffe08a,stop:1 #c8901e); }
QToolButton[role="coin"]:checked { border:3px solid #ffd34d; }
QToolButton[role="coin"]:disabled { color:#6b6f78; border:2px solid #2a2d33; background:#23262c; }
QToolButton[role="act"] { color:#ffffff; font-size:11px; border-radius:9px; border:2px solid rgba(0,0,0,170); background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #4cc16b,stop:1 #25773c); }
QToolButton[role="act"]:hover { border:2px solid rgba(255,255,255,170); background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #6ddc8b,stop:1 #2f9150); }
QToolButton[role="act"]:checked { border:3px solid #ffd34d; }
QToolButton[role="act"]:disabled { color:#6b6f78; border:2px solid #2a2d33; background:#23262c; }
QToolButton[role="pwr"] { color:#ffffff; font-size:11px; border-radius:9px; border:2px solid rgba(0,0,0,170); background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #ef6a5e,stop:1 #a3231a); }
QToolButton[role="pwr"]:hover { border:2px solid rgba(255,255,255,170); background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #ff8a7e,stop:1 #c4352a); }
QToolButton[role="pwr"]:checked { border:3px solid #ffd34d; }
QToolButton[role="pwr"]:disabled { color:#6b6f78; border:2px solid #2a2d33; background:#23262c; }
QToolButton[role="item"] { color:#1f1406; font-size:11px; border-radius:9px; border:2px solid rgba(0,0,0,170); background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #c9a36b,stop:1 #7a5a2c); }
QToolButton[role="item"]:hover { border:2px solid rgba(255,255,255,170); background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #e0bd86,stop:1 #94702f); }
QToolButton[role="item"]:checked { border:3px solid #ffd34d; }
QToolButton[role="item"]:disabled { color:#6b6f78; border:2px solid #2a2d33; background:#23262c; }
QToolButton[role="trk"] { color:#ffffff; font-size:13px; border-radius:22px; border:2px solid rgba(0,0,0,170); background:qradialgradient(cx:0.35,cy:0.3,radius:0.95,fx:0.35,fy:0.3,stop:0 #9aa6b8,stop:1 #3b4452); }
QToolButton[role="trk"]:hover { border:2px solid rgba(255,255,255,170); background:qradialgradient(cx:0.35,cy:0.3,radius:0.95,fx:0.35,fy:0.3,stop:0 #b9c4d4,stop:1 #52607a); }
QToolButton[role="trk"]:checked { border:3px solid #ffd34d; }
QToolButton[role="trk"]:disabled { color:#6b6f78; border:2px solid #2a2d33; background:#23262c; }
QToolButton[role="diag"] { color:#ffffff; font-size:11px; border-radius:9px; border:2px solid rgba(0,0,0,170); background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #7d8aa0,stop:1 #475264); }
QToolButton[role="diag"]:hover { border:2px solid rgba(255,255,255,170); background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #9aa6bb,stop:1 #5b6a82); }
QToolButton[role="diag"]:checked { border:3px solid #ffd34d; }
QToolButton[role="diag"]:disabled { color:#6b6f78; border:2px solid #2a2d33; background:#23262c; }
QLabel[role="title"] { color:#e0b565; font-weight:bold; font-size:12px; letter-spacing:2px; }
QLabel[role="note"] { color:#b79a8f; font-size:10px; }
QLabel#lTitle, QLabel[role="hint"] { color:#b79a8f; font-size:11px; }
QLabel#lInfos { color:#ffd34d; font-weight:bold; font-size:13px; }
QLabel[role="spinlabel"] { color:#e0b565; font-size:11px; }
QSpinBox { background:#26121a; color:#f3e6dc; border:1px solid #5a2b34; border-radius:5px; padding:2px 6px; }
QToolTip { background:#1f2530; color:#e6ecf7; border:1px solid #3a4352; padding:3px; }
QDialogButtonBox QPushButton { background:#3a1d24; color:#f3e6dc; border:1px solid #5a2b34; border-radius:6px; padding:6px 18px; min-width:70px; }
QDialogButtonBox QPushButton:hover { background:#4b2630; }
QDialogButtonBox QPushButton:pressed { background:#34191e; }</string></property>
