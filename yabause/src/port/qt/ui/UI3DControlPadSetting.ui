  <property name="styleSheet"><string notr="true">
QDialog#UI3DControlPadSetting { background:#f1f3f7; }
QLabel#label { background:#ffffff; }
QLabel#lHint { color:#6b7280; font-size:11px; }
QLabel#lInfos { color:#b45309; font-weight:bold; font-size:12px; }
QLabel#label_2, QLabel#label_3 { color:#374151; font-size:11px; }
QToolButton { background:rgba(37,99,235,26); border:2px solid rgba(37,99,235,140); }
QToolButton:hover { background:rgba(37,99,235,72); border:2px solid rgba(37,99,235,230); }
QToolButton:checked { background:rgba(245,158,11,90); border:3px solid #f59e0b; }
QToolButton#tbUp { border-radius:15px; }
QToolButton#tbX { border-radius:10px; }
QToolButton#tbY { border-radius:10px; }
QToolButton#tbZ { border-radius:10px; }
QToolButton#tbC { border-radius:10px; }
QToolButton#tbB { border-radius:10px; }
QToolButton#tbA { border-radius:10px; }
QToolButton#tbStart { border-radius:15px; }
QToolButton#tbRightTrigger { border-radius:20px; }
QToolButton#tbLeftTrigger { border-radius:20px; }
QToolButton#tbDown { border-radius:15px; }
QToolButton#tbRight { border-radius:15px; }
QToolButton#tbLeft { border-radius:15px; }
QToolButton#tbAxis1Left { border-radius:15px; }
QToolButton#tbAxis2Down { border-radius:15px; }
QDialogButtonBox QPushButton { background:#ffffff; color:#1f2937; border:1px solid #cbd2dc; border-radius:6px; padding:5px 16px; min-width:64px; }
QDialogButtonBox QPushButton:hover { background:#e8edf5; }
QDialogButtonBox QPushButton:pressed { background:#d9e0ec; }
</string></property>
