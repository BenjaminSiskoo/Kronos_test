QToolButton { background:rgba(37,99,235,26); border:2px solid rgba(37,99,235,140); }
QToolButton:hover { background:rgba(37,99,235,72); border:2px solid rgba(37,99,235,230); }
QToolButton:checked { background:rgba(245,158,11,90); border:3px solid #f59e0b; }
QToolButton#tbX { border-radius:10px; }
QToolButton#tbY { border-radius:10px; }
QToolButton#tbZ { border-radius:10px; }
QToolButton#tbC { border-radius:10px; }
