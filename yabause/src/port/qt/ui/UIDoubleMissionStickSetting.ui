QToolButton#tbStart { border-radius:15px; }
QToolButton#tbRightTrigger { border-radius:20px; }
QToolButton#tbLeftTrigger { border-radius:20px; }
QToolButton#tbAxis1Left { border-radius:15px; }
QToolButton#tbAxis2Down { border-radius:15px; }
QToolButton#tbAxis3Down { border-radius:15px; }
QToolButton#tbAxis5Left { border-radius:15px; }
QToolButton#tbAxis6Down { border-radius:15px; }
QToolButton#tbAxis7Down { border-radius:15px; }
QDialogButtonBox QPushButton { background:#ffffff; color:#1f2937; border:1px solid #cbd2dc; border-radius:6px; padding:5px 16px; min-width:64px; }
QDialogButtonBox QPushButton:hover { background:#e8edf5; }
QDialogButtonBox QPushButton:pressed { background:#d9e0ec; }
</string></property>
